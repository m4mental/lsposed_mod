<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="Dynamic Island Calibrator"
        android:theme="@android:style/Theme.DeviceDefault">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Island Calibrator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        
        <!-- अब आपको केवल System UI को हुक करने की आवश्यकता है, खुद के ऐप को नहीं! -->
        <meta-data
            android:name="xposedscope"
            android:value="com.android.systemui" />
        
        <meta-data
            android:name="xposeddescription"
            android:value="Adjustable Dynamic Island Hook for Nothing Phone 2a" />
        
        <meta-data
            android:name="xposedminversion"
            android:value="93" />

    </application>
</manifest>
