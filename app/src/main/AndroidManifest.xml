<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="Dynamic Island Calibrator"
        android:theme="@android:style/Theme.DeviceDefault">
        
        <!-- लॉन्चर ऐप एक्टिविटी -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Island Calibrator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- LSPosed को बताने के लिए कि यह एक मॉड्यूल है -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        
        <!-- ऑटोमैटिक स्कोप (Scope) रिकमेंडेशन: SystemUI और आपका ऐप खुद-ब-खुद सिलेक्ट हो जाएगा -->
        <meta-data
            android:name="xposedscope"
            android:value="com.android.systemui;com.example.dynamicisland" />
        
        <meta-data
            android:name="xposeddescription"
            android:value="Adjustable Dynamic Island Hook for Nothing Phone 2a" />
        
        <meta-data
            android:name="xposedminversion"
            android:value="93" />

    </application>
</manifest>
